/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal synthetic test profile for paired-guide CRISPRDecode counting
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    config_profile_name        = 'Test screening CRISPRDecode profile'
    config_profile_description = 'Synthetic truth set for exact paired-guide construct assignment'

    input                      = "$projectDir/tests/crisprdecode/fixtures/samplesheet.csv"
    analysis                   = 'screening'
    screening_count_method     = 'crisprdecode'
    library                    = "$projectDir/tests/crisprdecode/fixtures/library.tsv"
}

process {
    resourceLimits = [
        cpus: 2,
        memory: '4.GB',
        time: '30.m'
    ]
}
